# Copia este archivo a ".env" y rellena los valores.

# Cadena de conexión a PostgreSQL (obligatorio).
# Local: instala PostgreSQL y crea una base de datos "adictokebab".
# O usa un servicio gratuito en la nube (Neon, Supabase) y pega aquí su URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adictokebab

# Secreto para firmar la cookie de sesión (obligatorio). Pon una cadena larga y aleatoria.
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Cuenta de administrador (obligatorio). Se crea al arrancar el servidor.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Puerto del servidor API (el frontend Vite hace proxy de /api a este puerto).
PORT=3001

# Opcional: coordenadas de la tienda para estimar el tiempo de entrega (ETA).
# SHOP_LAT=41.5388
# SHOP_LNG=2.4449
